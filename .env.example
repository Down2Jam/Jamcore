# Local development and docker compose defaults.
# Copy this file to .env and replace secrets before running the app.

NODE_ENV=development
DOCKER_TARGET=dev
PORT=3005
FRONT_DEV_PORT=3000
CLIENT_ORIGIN=http://localhost:3000
# Dedicated HTTPS game host; must differ from the frontend and API origins.
# Set to https://play.d2jam.com in the D2Jam production environment.
GAME_BUILDS_ORIGIN=
FEDERATION_ORIGIN=http://localhost:3005
# Set these when running a local ClamAV daemon. Docker Compose configures them automatically.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
WEB_BUILD_REQUIRE_MALWARE_SCAN=false
RUNTIME_ROLE=all

POSTGRES_USER=jammer
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=jamcore
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5440/${POSTGRES_DB}

CACHE_PROVIDER=memory
RATE_LIMIT_PROVIDER=memory
# REDIS_URL=redis://redis:6379

TOKEN_SECRET=change-me-local-token-secret
# SERVICE_API_KEYS=local-service-key
# Register CLIENT_ORIGIN/settings/twitch-callback as an OAuth redirect URL in the Twitch developer console.
# Account linking requests an empty scope list and stores only the verified username.
# TWITCH_CLIENT_ID=local-twitch-client-id
# TWITCH_CLIENT_SECRET=local-twitch-client-secret
# APP_CONFIG_PATH=./config/app.local.json
# DISCORD_QUILT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional Cloudflare R2/S3-compatible storage for uploads.
# R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# R2_BUCKET_NAME=jamcore-dev
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me
